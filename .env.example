# ==============================================================================
# SPOTIFY WEB API CREDENTIALS (MANDATORY / OBRIGATÓRIAS)
# ==============================================================================
# Configure estas 4 chaves para autenticacao OAuth 2.0 e renovacao de access token.
SPOTIFY_CLIENT_ID=seu_spotify_client_id_aqui
SPOTIFY_CLIENT_SECRET=seu_spotify_client_secret_aqui
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/callback
SPOTIFY_REFRESH_TOKEN=seu_spotify_refresh_token_aqui

# Fallback para ambiente local Vite (opcional)
VITE_SPOTIFY_CLIENT_ID=seu_spotify_client_id_aqui
VITE_SPOTIFY_CLIENT_SECRET=seu_spotify_client_secret_aqui
VITE_SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/callback
VITE_SPOTIFY_REFRESH_TOKEN=seu_spotify_refresh_token_aqui

# ==============================================================================
# BACKEND & DATABASE CONFIGURATIONS (FASTAPI & POSTGRESQL)
# ==============================================================================
DATABASE_URL=postgresql://portfolio_user:portfolio_pass@localhost:5432/portfolio_db
POSTGRES_USER=portfolio_user
POSTGRES_PASSWORD=portfolio_pass
POSTGRES_DB=portfolio_db

# JWT & Admin Security
JWT_SECRET_KEY=super_secure_jwt_secret_key_minimum_32_bytes_long_portfolio_2026
JWT_ALGORITHM=HS256
ADMIN_DEFAULT_USERNAME=elyyihz
ADMIN_DEFAULT_PASSWORD=admin123

# ==============================================================================
# AI ASSISTANT & RAG CONFIGURATIONS (GOOGLE GEMINI & QDRANT)
# ==============================================================================
GEMINI_API_KEY=seu_gemini_api_key_aqui

# ==============================================================================
# GAMING & RICH PRESENCE (STEAM WEB API & DISCORD RPC)
# ==============================================================================
STEAM_API_KEY=seu_steam_api_key_aqui
STEAM_ID=seu_steam_id_64_aqui

# Frontend Gateway Endpoint
VITE_BACKEND_API_URL=http://localhost:8000
